# Copy to .env. The first admin is created from these on startup.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=use-a-long-unique-password
PORT=3000
# NODE_ENV=production        # turns on Secure cookies; use only behind HTTPS
# DATA_DIR=/data             # where the database and resumes live (mount a persistent disk here)
# Beta OTP testing on a deployed service (exposes codes only for listed email addresses):
# BETA_TEST_MODE=true
# BETA_TEST_EMAILS=you@example.com,qa@example.com
